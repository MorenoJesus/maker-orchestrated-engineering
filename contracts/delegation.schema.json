{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/moe/0.3.0/delegation.schema.json",
  "title": "Delegation",
  "type": "object",
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "record_mode": {"enum": ["fixture", "operational"]},
    "mission": {"$ref": "common.schema.json#/$defs/record_ref"},
    "policy": {"$ref": "common.schema.json#/$defs/record_ref"},
    "agent": {"$ref": "common.schema.json#/$defs/actor"},
    "objective": {"type": "string", "minLength": 1},
    "resources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "environment": {"type": "string", "minLength": 1},
    "allowed_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "expected_outputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "acceptance_criterion_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/id"},
      "minItems": 1,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/id"},
      "minItems": 0,
      "uniqueItems": true
    },
    "budget": {"$ref": "common.schema.json#/$defs/budget"},
    "stop_conditions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "escalation_owner": {"type": "string", "minLength": 1},
    "extensions": {"type": "object"}
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "record_mode",
    "mission",
    "policy",
    "agent",
    "objective",
    "resources",
    "environment",
    "allowed_actions",
    "expected_outputs",
    "acceptance_criterion_ids",
    "dependencies",
    "budget",
    "stop_conditions",
    "escalation_owner",
    "extensions"
  ],
  "additionalProperties": false
}
